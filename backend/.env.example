# --- BMONI sandbox ---
# Never hardcode this in code — read from env only.
BMONI_API_KEY=your_bmoni_sandbox_x_api_key
BMONI_BASE_URL=https://embedded-dev.bmoni.com

# --- Gemini (intent parsing + plain-language responses) ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash

# --- YarnGPT (hosted TTS) ---
YARNGPT_API_KEY=your_yarngpt_api_key
YARNGPT_API_BASE_URL=https://yarngpt.ai/api/v1

# --- Whisper (local STT) ---
# tiny | base | small | medium | large — bigger = more accurate, slower, more RAM.
WHISPER_MODEL_SIZE=base

# --- Local app data ---
DATABASE_URL=sqlite:///./bmoni_copilot.db
# How long a prepared transfer (post-guardian-check, pre-PIN-confirmation) stays valid.
PENDING_TRANSFER_TTL_SECONDS=300
